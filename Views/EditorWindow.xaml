<Window x:Class="RedShot.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RedShot"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="ToolToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Obere horizontale Iconleiste -->
        <ToolBar Grid.Row="0"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Height="34"
                 Padding="2"
                 ToolBarTray.IsLocked="True">
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="💾"
                    ToolTip="Speichern unter..."
                    Click="SaveAs_Click"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="▣"
                    ToolTip="In Zwischenablage kopieren"
                    Click="Copy_Click"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="🖨"
                    ToolTip="Drucken"
                    Click="NotImplemented_Click"/>
            <Separator/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="⛔"
                    ToolTip="Löschen"
                    Click="NotImplemented_Click"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="✂"
                    ToolTip="Ausschneiden"
                    Click="NotImplemented_Click"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="▧"
                    ToolTip="Bild öffnen/einfügen"
                    Click="NotImplemented_Click"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="📋"
                    ToolTip="Einfügen"
                    Click="NotImplemented_Click"/>
            <Separator/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="↶"
                    ToolTip="Rückgängig"
                    Click="NotImplemented_Click"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="↷"
                    ToolTip="Wiederholen"
                    Click="NotImplemented_Click"/>
            <Separator/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="⚙"
                    ToolTip="Einstellungen"
                    Click="NotImplemented_Click"/>
            <Separator/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Content="ⓘ"
                    ToolTip="Über RedShot"
                    Click="About_Click"/>
        </ToolBar>

        <!-- Linke Werkzeugleiste: absichtlich KEINE WPF-ToolBar,
             damit es keinerlei Overflow-/Aufklappmechanismus gibt. -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,1,0"
                Padding="3,2">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                <ToggleButton x:Name="SelectToolButton"
                              Style="{StaticResource ToolToggleButtonStyle}"
                              Content="↖"
                              ToolTip="Auswahl"
                              Tag="Select"
                              IsChecked="True"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="□"
                              ToolTip="Rechteck"
                              Tag="Rectangle"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="○"
                              ToolTip="Ellipse"
                              Tag="Ellipse"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="╱"
                              ToolTip="Linie"
                              Tag="Line"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="↗"
                              ToolTip="Pfeil"
                              Tag="Arrow"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="✎"
                              ToolTip="Freihand"
                              Tag="Freehand"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="T"
                              ToolTip="Text"
                              Tag="Text"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="▱"
                              ToolTip="Sprechblase"
                              Tag="SpeechBubble"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="①"
                              ToolTip="Nummerierung"
                              Tag="Counter"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="abc"
                              FontSize="10"
                              ToolTip="Hervorheben"
                              Tag="Highlight"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="▧"
                              ToolTip="Bild einfügen"
                              Tag="Image"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="✵"
                              ToolTip="Effekte"
                              Tag="Effects"
                              Click="Tool_Click"/>

                <Border Height="1"
                        Width="24"
                        Margin="2,4"
                        Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="⌗"
                              ToolTip="Zuschneiden"
                              Tag="Crop"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="↻"
                              ToolTip="Drehen"
                              Tag="Rotate"
                              Click="Tool_Click"/>
                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              Content="↙↗"
                              FontSize="11"
                              ToolTip="Größe ändern"
                              Tag="Resize"
                              Click="Tool_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#222">
            <Image x:Name="PreviewImage"
                   Stretch="None"/>
        </ScrollViewer>
    </Grid>
</Window>
